    "sections": {
      "intro": {
        "title": "Introduction",
        "body": "Free Business (\"we\", \"our\") operates the Free Business mobile app and related services at apps.freebusinessgip.com. This policy explains what data we collect and how we use it."
      },
      "dataWeCollect": {
        "title": "Data we collect",
        "body": "Account information (name, email, phone, location), profile photo, posts, property listings, group membership, messages sent through our chat provider, device/network data for security, and reward program activity."
      },
      "howWeUse": {
        "title": "How we use data",
        "body": "We use your data to provide the app, authenticate you, enable messaging, process rewards, improve security, and respond to support requests."
      },
      "sharing": {
        "title": "Sharing",
        "body": "We use trusted processors including MongoDB hosting, Stream (chat), and optional Cloudinary (images). We do not sell your personal data."
      },
      "retention": {
        "title": "Retention",
        "body": "We keep data while your account is active. When you delete your account, we remove your profile and associated content from our database within a reasonable period."
      },
      "yourRights": {
        "title": "Your rights",
        "body": "You can update your profile in the app, request account deletion from Profile settings, and contact us to ask questions about your data."
      },
      "security": {
        "title": "Security",
        "body": "We use HTTPS, password hashing, and access controls. No method of transmission over the internet is 100% secure."
      },
      "children": {
        "title": "Children",
        "body": "The app is not directed at children under 13. We do not knowingly collect data from children."
      },
      "contact": {
        "title": "Contact",
        "body": "Email support@freebusinessgip.com for privacy requests or questions about this policy."
      }
    }
  }
